/* Base styles and content styles */

@import "variables.css";

:root {
	/* Browser default font-size is 16px, this way 1 rem = 10px */
	font-size: 62.5%;
}

/* ===== TABLE OF CONTENTS (TOC) ===== */
.toc-smart {
    position: fixed;
    top: 8.6rem;
    right: 1rem;
    width: 240px; /* Уменьшил с 280px до 240px */
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    border-radius: var(--border-radius);
    padding: 1rem 1.2rem; /* Чуть уменьшил паддинги */
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--card-bg);
    z-index: 100;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.toc-title {
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 1px;
    opacity: 0.5;
}

.toc-smart ul {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
    width: 100%;
    overflow-x: hidden;
}

.toc-smart li {
    margin-bottom: .5rem;
    line-height: 1.4;
    transition: opacity 0.2s;
    width: 100%;
    white-space: normal;
    word-wrap: break-word;
}

.toc-smart a {
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
    display: inline-block;
    max-width: 100%;
    word-break: break-word;
}

.toc-smart a:hover {
    border-bottom-color: currentColor;
}

/* ===== HEADING HIERARCHY ===== */
.toc-h1 {
    font-size: 1.3rem; /* Чуть уменьшил для узкой колонки */
    font-weight: 600;
    margin-bottom: .5rem !important;
    width: 100%;
}

.toc-h1 a {
    font-weight: 600;
    max-width: 100%;
}

.toc-h2 {
    font-size: 1.2rem; /* Чуть уменьшил */
    padding-left: 12px; /* Уменьшил отступ */
    font-weight: 500;
    width: calc(100% - 12px);
    box-sizing: border-box;
}

.toc-h3 {
    font-size: 0.95rem; /* Чуть уменьшил */
    padding-left: 24px; /* Уменьшил отступ */
    font-weight: 400;
    margin-top: -.2rem;
    width: calc(100% - 24px);
    box-sizing: border-box;
}

/* ===== CURRENT SECTION INDICATOR ===== */
.toc-smart .current-section {
    font-weight: 700 !important;
    border-left: 2px solid;
    padding-left: 10px; /* Уменьшил */
    margin-left: -12px; /* Подогнал */
    width: calc(100% + 2px);
    box-sizing: border-box;
}

.toc-smart .current-section a {
    max-width: calc(100% - 2px);
}

.toc-smart .past-section a {
    opacity: 0.5;
}

.toc-smart .past-section.current-section a {
    opacity: 1;
}

/* Active item (backward compatibility) */
.toc-smart .active {
    font-weight: 700 !important;
    border-left: 2px solid;
    padding-left: 10px;
    margin-left: -12px;
    width: calc(100% + 2px);
    box-sizing: border-box;
}

/* ===== READING STATISTICS ===== */
.toc-footer {
    margin-top: 1.2rem; /* Чуть меньше */
    padding-top: 0.8rem; /* Чуть меньше */
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem; /* Чуть меньше */
    opacity: 0.8;
    position: sticky;
    bottom: 0;
    background: var(--card-bg);
    width: 100%;
    box-sizing: border-box;
}

.reading-time {
    display: flex;
    align-items: center;
    gap: 4px; /* Меньше gap */
    margin-bottom: 0.6rem; /* Меньше */
    white-space: nowrap;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.read-progress {
    display: flex;
    align-items: center;
    gap: 6px; /* Меньше gap */
    width: 100%;
}

.progress-bar-bg {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    min-width: 40px; /* Меньше минимум */
}

.progress-bar-fill {
    height: 100%;
    width: 0%;
    background: currentColor;
    opacity: 0.5;
    transition: width 0.1s ease;
}

.progress-percent {
    min-width: 40px; /* Меньше */
    text-align: right;
    font-feature-settings: "tnum";
    font-size: 0.85rem; /* Меньше */
    flex-shrink: 0;
}

/* ===== MOBILE ===== */
@media (max-width: 1000px) {
    .toc-smart {
        position: static;
        width: 100%;
        max-height: none;
        margin-bottom: 2rem;
        padding: 1rem;
    }
    
    .toc-footer {
        position: static;
    }
    
    .toc-h2 {
        padding-left: 12px;
        width: calc(100% - 12px);
    }
    
    .toc-h3 {
        padding-left: 24px;
        width: calc(100% - 24px);
    }
}

@media (max-width: 700px) {
    .toc-smart {
        display: none;
    }
}

html {
	font-family: "Open Sans", sans-serif;
	color: var(--text-primary);
	text-size-adjust: none;
}

body {
	margin: 0;
	font-size: 1.6rem;
	overflow-x: hidden;
	min-height: 100vh;
}

code {
	font-family: "Source Code Pro", Consolas, "Ubuntu Mono", Menlo,
		"DejaVu Sans Mono", monospace, monospace !important;
	font-size: 0.875em;
}

.left {
	float: left;
}
.right {
	float: right;
}
.boring {
	opacity: 0.6;
}
.hide-boring .boring {
	display: none;
}
.hidden {
	display: none;
}

h1 {
	margin-top: 2%;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	width: 100%;
}

h2,
h3 {
	margin-top: 5%;
}

h4,
h5 {
	margin-top: 2em;
}

.header + .header h3,
.header + .header h4,
.header + .header h5 {
	margin-top: 1em;
}

h1 a.header:target::before,
h2 a.header:target::before,
h3 a.header:target::before,
h4 a.header:target::before {
	display: inline-block;
	content: "»";
	margin-left: -30px;
	width: 30px;
}

h1 a.header:target,
h2 a.header:target,
h3 a.header:target,
h4 a.header:target {
	scroll-margin-top: calc(70px + 0.5em);
}

.page {
	outline: 0;
	padding: 0 5px;
}
.page-wrapper {
	box-sizing: border-box;
}

.content {
	overflow-y: auto;
	padding: 0 15px;
	padding-bottom: 50px;
}

.content main {
	margin-left: 2rem;
	margin-right: 9rem;
	max-width: 700px;
}

.content a {
	text-decoration: none;
}
.content a:hover {
	text-decoration: underline;
}
.content img {
	max-width: 100%;
}
.content .header:link,
.content .header:visited {
	color: #fff;
}
.content .header:link,
.content .header:visited:hover {
	text-decoration: none;
}

/* Tables */

.table-wrapper {
    overflow-x: auto;
}

table {
	border-collapse: separate;
	border-spacing: 0;
	border-radius: var(--border-radius);
	overflow: hidden;
	width: 100%;
	box-shadow: 2px 10px 10px rgba(0, 0, 0, 0.3);
	table-layout: auto;
}

table td, table th {
	max-width: 100rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
}

table td {
	padding: 1rem 2rem;
	border: 0;
	border-radius: 0px !important;
}

table thead {
	background: var(--card-bg);
	border-radius: var(--border-radius) var(--border-radius) 0 0;
}

table thead td {
	font-weight: bold;
}

table thead th {
	padding: 1rem;
	border-bottom: 1px solid hsl(0deg 0% 100% / 10%);
}

table thead tr {
	border: 1px;
	border-radius: var(--border-radius) var(--border-radius) 0 0;
}

table tbody tr:nth-child(2n) {
	opacity: 0.9;
	background: var(--card-bg);
}

table tbody tr:last-child td:first-child {
	border-radius: 0 0 0 var(--border-radius);
}

table tbody tr:last-child td:last-child {
	border-radius: 0 0 var(--border-radius) 0;
}

/* Blockquote */

blockquote {
	margin: 20px 0;
	padding: 0.1px 20px;
	background-color: var(--card-bg);
	border: solid !important;
	border-radius: 0 10px 10px 0 !important;
	border-width: 0 0 0 4px !important;
	border-color: var(--link-color) !important;
	box-shadow: 2.5px 2.5px 10px rgb(0 0 0 / 50%);
}

:not(.footnote-definition) + .footnote-definition,
.footnote-definition + :not(.footnote-definition) {
	margin-top: 2em;
}
.footnote-definition {
	font-size: 0.9em;
	margin: 0.5em 0;
}
.footnote-definition p {
	display: inline;
}

.tooltiptext {
	position: absolute;
	visibility: hidden;
	color: #fff;
	background-color: var(--card-bg);
	transform: translateX(-50%);
	left: 80%;
	top: -90%;
	font-size: 80%;
	font-style: normal;
	font-family: system-ui;
	text-align: center;
	border-radius: 10px;
	padding: 5px 8px;
	margin: 5px;
	z-index: 1000;
}

.tooltipped .tooltiptext {
	visibility: visible;
}
